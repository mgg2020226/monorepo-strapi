{
  "name": "strapi-next-monorepo-starter",
  "version": "3.0.0",
  "private": true,
  "author": {
    "name": "Notum Technologies",
    "email": "info@notum.cz",
    "url": "https://notum.cz"
  },
  "maintainers": [
    {
      "name": "Notum Technologies",
      "email": "info@notum.cz",
      "url": "https://notum.cz"
    }
  ],
  "scripts": {
    "build": "turbo build --cache-dir=.turbo",
    "build:strapi": "turbo run build --filter=@repo/strapi",
    "build:empresax": "turbo run build --filter=@repo/empresax",
    "build:empresax:static": "NODE_OPTIONS=--max-old-space-size=2048 turbo run build:static --filter=@repo/empresax",
    "build:nexon-group": "turbo run build --filter=@repo/nexon-group",
    "build:bancaliv": "turbo run build --filter=@repo/bancaliv",
    "build:cae": "turbo run build --filter=@repo/cae",
    "dev": "turbo dev",
    "dev:strapi": "turbo run dev --filter=@repo/strapi",
    "dev:empresax": "turbo run dev --filter=@repo/empresax",
    "dev:nexon-group": "turbo run dev --filter=@repo/nexon-group",
    "dev:bancaliv": "turbo run dev --filter=@repo/bancaliv",
    "dev:cae": "turbo dev --filter=@repo/cae",
    "generate:types": "turbo run generate:types --filter=@repo/strapi",
    "preinstall": "npx only-allow pnpm",
    "postinstall": "pnpm run setup:apps",
    "seed:check": "turbo run seed:check --filter=@repo/strapi",
    "seed:export": "turbo run seed:export --filter=@repo/strapi",
    "seed:import": "turbo run seed:import --filter=@repo/strapi",
    "setup:apps": "node scripts/setup-apps.mjs",
    "start:strapi": "turbo run start --filter=@repo/strapi",
    "start:empresax": "turbo run start --filter=@repo/empresax",
    "start:bancaliv": "turbo run start --filter=@repo/bancaliv",
    "sync-types": "turbo run sync-types --filter=@repo/strapi-types",
    "test": "turbo run test",
    "test:ci": "turbo run test",
    "test:strapi": "turbo run test --filter=@repo/strapi",
    "test:empresax": "turbo run test --filter=@repo/empresax",
    "transfer:strapi": "turbo run transfer --filter=@repo/strapi",
    "typecheck": "turbo run typecheck",
    "typecheck:strapi": "turbo run typecheck --filter=@repo/strapi",
    "typecheck:empresax": "turbo run typecheck --filter=@repo/empresax",
    "typecheck:nexon-group": "turbo run typecheck --filter=@repo/nexon-group",
    "typecheck:bancaliv": "turbo run typecheck --filter=@repo/bancaliv",
    "typecheck:cae": "turbo run typecheck --filter=@repo/cae",
    "test:bancaliv": "turbo run test --filter=@repo/bancaliv",
    "test:cae": "turbo run test --filter=@repo/cae",
    "worktree:cleanup": "scripts/worktree/cleanup.sh",
    "worktree:create": "scripts/worktree/create.sh",
    "worktree:setup": "scripts/worktree/setup.sh"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "tslib": "2.8.1",
    "turbo": "2.9.18"
  },
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": "^24.0.0"
  }
}
