{
  "name": "@repo/design-system",
  "version": "1.0.0",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./ui/*": "./src/ui/*.tsx",
    "./forms/*": "./src/forms/*.tsx",
    "./typography": "./src/typography/index.tsx",
    "./typography/config": "./src/typography/config.ts",
    "./typography/helpers": "./src/typography/helpers.ts",
    "./typography/element": "./src/typography/element/index.tsx",
    "./elementary/ck-editor": "./src/elementary/ck-editor/index.tsx",
    "./elementary/ck-editor/utils": "./src/elementary/ck-editor/utils.ts",
    "./elementary/tiptap-editor": "./src/elementary/tiptap-editor/index.tsx",
    "./elementary/tiptap-editor/extensions": "./src/elementary/tiptap-editor/extensions.tsx",
    "./elementary/tiptap-editor/utils": "./src/elementary/tiptap-editor/utils.ts",
    "./elementary/data-table/*": "./src/elementary/data-table/*.tsx",
    "./elementary/*": "./src/elementary/*.tsx",
    "./hooks/useNavbarMobile": "./src/hooks/useNavbarMobile.tsx",
    "./hooks/useTranslatedZod": "./src/hooks/useTranslatedZod.ts",
    "./utils": "./src/utils.ts",
    "./theme.css": "./src/theme.css",
    "./ckeditor-default-styles.css": "./src/ckeditor-default-styles.css",
    "./styles.css": "./dist/styles.css",
    "./tiptap-color-config.json": "./dist/tiptap-color-config.json",
    "./tiptap-theme.css": "./dist/tiptap-theme.css",
    "./styles-strapi.json": "./dist/styles-strapi.json",
    "./custom-styles.css": "./src/custom-styles.css",
    "./ck-color-config.json": "./dist/ckeditor-color-config.json",
    "./ck-fontSize-config.json": "./dist/ckeditor-fontSize-config.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tailwindcss -i ./src/styles.css -o ./dist/styles.css && node ./src/build-ck-config.js && node ./src/build-tiptap-config.js",
    "dev": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch",
    "lint": "eslint -c ../../eslint.config.mjs .",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "1.2.14",
    "@radix-ui/react-checkbox": "1.3.5",
    "@radix-ui/react-dialog": "1.1.17",
    "@radix-ui/react-dropdown-menu": "2.1.18",
    "@radix-ui/react-icons": "1.3.2",
    "@radix-ui/react-label": "2.1.10",
    "@radix-ui/react-navigation-menu": "1.2.16",
    "@radix-ui/react-popover": "1.1.17",
    "@radix-ui/react-radio-group": "1.4.1",
    "@radix-ui/react-select": "2.3.1",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-tabs": "1.1.15",
    "@radix-ui/react-tooltip": "1.2.10",
    "@repo/strapi-types": "workspace:*",
    "@tailwindcss/cli": "4.3.1",
    "@tailwindcss/postcss": "4.3.1",
    "@tanstack/react-table": "8.21.3",
    "@tiptap/core": "3.20.6",
    "@tiptap/extension-color": "3.20.6",
    "@tiptap/extension-heading": "3.20.6",
    "@tiptap/extension-highlight": "3.20.6",
    "@tiptap/extension-image": "3.20.6",
    "@tiptap/extension-subscript": "3.20.6",
    "@tiptap/extension-superscript": "3.20.6",
    "@tiptap/extension-table": "3.20.6",
    "@tiptap/extension-text-align": "3.20.6",
    "@tiptap/extension-text-style": "3.20.6",
    "@tiptap/react": "3.20.6",
    "@tiptap/starter-kit": "3.20.6",
    "@tiptap/static-renderer": "3.20.6",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.21",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.18.0",
    "next": "16.3.3",
    "next-intl": "4.13.0",
    "next-themes": "0.4.6",
    "postcss": "8.5.26",
    "prosemirror-model": "1.25.4",
    "radix-ui": "1.6.0",
    "react": "19.3.0",
    "react-day-picker": "10.0.1",
    "react-dom": "19.3.0",
    "react-hook-form": "7.79.0",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss-modules-values": "4.0.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^24.0.0"
  }
}
