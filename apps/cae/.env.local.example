# Strapi API used by this app. Never commit the real API key.
STRAPI_URL=http://127.0.0.1:1337
STRAPI_REST_READONLY_API_KEY=
APP_PUBLIC_URL=http://localhost:3000

# Map this app's hostnames to the actual Site.slug from Strapi.
# Example: {"localhost":"<actual-cae-site-slug>","127.0.0.1":"<actual-cae-site-slug>"}
SITE_DOMAIN=

STRAPI_PREVIEW_SECRET=
STRAPI_REVALIDATE_SECRET=
