{
  "kind": "collectionType",
  "collectionName": "servicio_items",
  "info": {
    "singularName": "servicio-item",
    "pluralName": "servicio-items",
    "displayName": "Servicio Item"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "short_description": {
      "type": "text",
      "required": true
    },
    "full_description": {
      "type": "text",
      "required": true
    },
    "icon_name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "type": {
      "type": "enumeration",
      "enum": ["producto", "tramite"],
      "required": true
    },
    "badge_label": {
      "type": "string"
    },
    "badge_color": {
      "type": "enumeration",
      "enum": ["green", "blue", "orange", "gray"],
      "default": "green"
    },
    "estimated_days": {
      "type": "integer"
    },
    "estimated_note": {
      "type": "string"
    },
    "action_label": {
      "type": "string"
    },
    "action_url": {
      "type": "string"
    },
    "map_address": {
      "type": "string"
    },
    "map_city": {
      "type": "string"
    },
    "map_url": {
      "type": "string"
    },
    "requirements": {
      "type": "component",
      "component": "catastro.requirement-item",
      "repeatable": true
    },
    "deliverables": {
      "type": "component",
      "component": "catastro.deliverable-item",
      "repeatable": true
    },
    "sort_order": {
      "type": "integer",
      "default": 0
    },
    "manager": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::manager.manager"
    }
  }
}
