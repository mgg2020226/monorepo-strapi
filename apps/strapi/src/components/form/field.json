{
  "collectionName": "components_form_fields",
  "info": { "displayName": "Form field", "icon": "input" },
  "options": {},
  "attributes": {
    "name": { "type": "string", "required": true },
    "label": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "type": { "type": "enumeration", "enum": ["text", "email", "tel", "number", "date", "time", "textarea", "select", "checkbox", "radio", "file"], "required": true },
    "placeholder": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "helpText": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "required": { "type": "boolean", "default": false },
    "order": { "type": "integer", "default": 0 },
    "options": { "type": "component", "component": "form.option", "repeatable": true },
    "minLength": { "type": "integer" },
    "maxLength": { "type": "integer" },
    "minValue": { "type": "decimal" },
    "maxValue": { "type": "decimal" },
    "accept": { "type": "string" },
    "visible": { "type": "boolean", "default": true }
  }
}
