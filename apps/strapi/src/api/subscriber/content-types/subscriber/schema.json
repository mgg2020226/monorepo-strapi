{
  "kind": "collectionType",
  "collectionName": "subscribers",
  "info": {
    "singularName": "subscriber",
    "pluralName": "subscribers",
    "displayName": "Subscriber"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "message": {
      "type": "text"
    },
    "formSlug": {
      "type": "string",
      "required": true
    },
    "submissionData": {
      "type": "json",
      "required": true
    },
    "site": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::site.site",
      "inversedBy": "subscribers",
      "required": true
    },
    "content": {
      "type": "customField",
      "customField": "plugin::tiptap-editor.RichText"
    }
  }
}
