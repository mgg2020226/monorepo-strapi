{
  "kind": "collectionType",
  "collectionName": "calendar_events",
  "info": { "singularName": "calendar-event", "pluralName": "calendar-events", "displayName": "Calendar event" },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "title": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "slug": { "type": "uid", "targetField": "title", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "description": { "type": "richtext", "pluginOptions": { "i18n": { "localized": true } } },
    "site": { "type": "relation", "relation": "manyToOne", "target": "api::site.site", "inversedBy": "calendarEvents", "required": true },
    "startDate": { "type": "date", "required": true },
    "startTime": { "type": "time", "required": true },
    "endDate": { "type": "date" },
    "endTime": { "type": "time" },
    "location": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "registrationUrl": { "type": "string" },
    "image": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "contentStatus": { "type": "enumeration", "enum": ["draft", "published", "cancelled"], "default": "draft", "required": true },
    "seo": { "type": "component", "component": "seo.metadata", "repeatable": false, "pluginOptions": { "i18n": { "localized": true } } }
  }
}
