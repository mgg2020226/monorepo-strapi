{
  "kind": "collectionType",
  "collectionName": "cms_user_access",
  "info": { "singularName": "cms-user-access", "pluralName": "cms-user-accesses", "displayName": "CMS user access" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "adminUserId": { "type": "integer", "required": true, "unique": true },
    "email": { "type": "email", "required": true },
    "displayName": { "type": "string", "required": true },
    "role": { "type": "enumeration", "enum": ["platform-admin", "site-manager", "editor", "reviewer"], "required": true, "default": "editor" },
    "sites": { "type": "relation", "relation": "manyToMany", "target": "api::site.site", "inversedBy": "cmsUsers" },
    "permissions": { "type": "component", "component": "admin.permission", "repeatable": true, "required": true },
    "active": { "type": "boolean", "default": true },
    "notes": { "type": "text" }
  }
}
