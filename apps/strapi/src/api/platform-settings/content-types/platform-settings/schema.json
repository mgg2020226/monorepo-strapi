{
  "kind": "singleType",
  "collectionName": "platform_settings",
  "info": { "singularName": "platform-settings", "pluralName": "platform-settings-config", "displayName": "Platform settings" },
  "options": { "draftAndPublish": false },
  "attributes": {
    "defaultLocale": { "type": "enumeration", "enum": ["es", "en", "es-CO"], "default": "es", "required": true },
    "availableLocales": { "type": "json", "default": ["es", "en", "es-CO"], "required": true },
    "globalRobotsPolicy": { "type": "enumeration", "enum": ["index", "noindex"], "default": "index", "required": true },
    "securityContactEmail": { "type": "email", "required": true },
    "maintenanceMode": { "type": "boolean", "default": false },
    "maintenanceMessage": { "type": "text" }
  }
}
