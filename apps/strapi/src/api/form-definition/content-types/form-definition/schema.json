{
  "kind": "collectionType",
  "collectionName": "form_definitions",
  "info": { "singularName": "form-definition", "pluralName": "form-definitions", "displayName": "Form definition" },
  "options": { "draftAndPublish": false },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true, "unique": true },
    "site": { "type": "relation", "relation": "manyToOne", "target": "api::site.site", "inversedBy": "forms", "required": true },
    "title": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "description": { "type": "text", "pluginOptions": { "i18n": { "localized": true } } },
    "fields": { "type": "component", "component": "form.field", "repeatable": true, "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "submitLabel": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "successMessage": { "type": "text", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "errorMessage": { "type": "text", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "recipientEmail": { "type": "email", "required": true },
    "active": { "type": "boolean", "default": true },
    "honeypotEnabled": { "type": "boolean", "default": true },
    "rateLimitPerMinute": { "type": "integer", "default": 5, "min": 1, "max": 60 }
  }
}
