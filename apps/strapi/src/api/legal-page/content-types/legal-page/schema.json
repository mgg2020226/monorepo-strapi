{
  "kind": "collectionType",
  "collectionName": "legal_pages",
  "info": { "singularName": "legal-page", "pluralName": "legal-pages", "displayName": "Legal page" },
  "options": { "draftAndPublish": true },
  "pluginOptions": { "i18n": { "localized": true } },
  "attributes": {
    "title": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "slug": { "type": "uid", "targetField": "title", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "content": { "type": "richtext", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "site": { "type": "relation", "relation": "manyToOne", "target": "api::site.site", "inversedBy": "legalPages", "required": true },
    "legalType": { "type": "enumeration", "enum": ["privacy", "cookies", "terms", "accessibility", "other"], "required": true },
    "version": { "type": "string" },
    "effectiveDate": { "type": "date" },
    "seo": { "type": "component", "component": "seo.metadata", "repeatable": false, "pluginOptions": { "i18n": { "localized": true } } },
    "contentStatus": { "type": "enumeration", "enum": ["draft", "published", "archived"], "default": "draft", "required": true }
  }
}
