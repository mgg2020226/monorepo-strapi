# Tweak for your needs and rename to .env
# Do not leave empty values, e.g. `DATABASE_PASSWORD=`, as it is interpreted as an empty string and
# default values won't be used. If you want to fallback to default values, remove or comment the line completely.

# ----- Strapi general -----

# The host where Strapi will listen.
HOST=0.0.0.0

# The port where Strapi will listen.
PORT=1337

# The secret keys used to sign the session cookies.
APP_KEYS=replace-with-key-1,replace-with-key-2,replace-with-key-3,replace-with-key-4

# The secret used to sign the API tokens.
API_TOKEN_SALT=replace-with-api-token-salt

# The secret used to sign the JWT for the Admin panel.
ADMIN_JWT_SECRET=replace-with-admin-jwt-secret

# The secret used to sign the JWT for the Users-Permissions plugin
JWT_SECRET=replace-with-jwt-secret

# The secret used to sign the token for transfer data between 2 Strapi instances.
# TRANSFER_TOKEN_SALT=

# Enable or disable cron jobs. Default: false
# CRON_ENABLED=

# Enable or disable the built-in Strapi MCP server at /mcp.
# Default: true in development, false elsewhere.
# STRAPI_MCP_ENABLED=

# Sets the public URL of the application (usually related to production deploy).
APP_URL=http://localhost:1337

# The URL of the admin panel. Consumed by frontend of custom strapi plugin.
# STRAPI_ADMIN_BACKEND_URL=http://localhost:1337

# Enable or disable receiving populated relations in webhooks. Default: false
# WEBHOOKS_POPULATE_RELATIONS=

# The license key for Strapi.
# STRAPI_LICENSE=

# ----- Database -------

# Full connection string for the database. It has higher priority than the other database connection options.
# DATABASE_URL=

# The database client to use.
DATABASE_CLIENT=postgres

# The database host.
DATABASE_HOST=localhost

# The database port.
DATABASE_PORT=5432

# The database name.
DATABASE_NAME=strapi-db

# The database username.
DATABASE_USERNAME=admin

# The database password.
DATABASE_PASSWORD=replace-with-database-password

# Enable SSL support.
DATABASE_SSL=false

# Reject invalid certificates when SSL is enabled.
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Connection pool limits.
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# The database schema (PostgreSQL only). Default: public
DATABASE_SCHEMA=public

# Test database name. Default: .tmp/test.db
# TEST_DATABASE_FILENAME=

# ----- AWS S3 storage -----

AWS_ACCESS_KEY_ID=
AWS_ACCESS_SECRET=
AWS_REGION=
AWS_BUCKET=
AWS_FORCE_PATH_STYLE=false
UPLOAD_SIZE_LIMIT_MB=25

# Set 'private' if you want to make the uploaded files private. Default: 'public-read'.
# AWS_ACL=

# Expiration time of signed url in seconds. Default: 15 * 60.
# AWS_SIGNED_URL_EXPIRES=

# If you're using the bucket as a CDN and deliver the content on a custom domain, you can get use of the baseUrl
# and rootPath properties to configure how your assets' urls will be saved inside Strapi.
# CDN_URL=
# CDN_ROOT_PATH=

# ------- SMTP --------
# Development: Mailpit. Production: self-hosted Postal/Maddy or another SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ------- Typesense --------
TYPESENSE_HOST=
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=

# ------- Frontend integration --------

# Base URL of the frontend. Can be used by backend to generate links to frontend.
CLIENT_URL=http://localhost:3000
# Bearer secret authenticating cache revalidation requests sent from Strapi to
# the Next.js UI. Must match STRAPI_REVALIDATE_SECRET in apps/empresaX.
STRAPI_REVALIDATE_SECRET=

# ------- OTHER -------

# Link to the frontend account activation page. It is used in email templates sent by backend.
# CLIENT_ACCOUNT_ACTIVATION_URL=http://localhost:3000/auth/activate

# Setting a token enables injecting of runtime variables into the admin panel (to inject CSS, variables, etc.).
# Use a long, randomly generated secret string (for example: `openssl rand -hex 32`).
# ADMIN_PANEL_CONFIG_API_AUTH_TOKEN=your-secure-random-token-here
